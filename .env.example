# 数据库位置（默认 ~/.local/share/rs-service/rs.db）
# RS_DB_PATH=/home/siri/.local/share/rs-service/rs.db

# 数据库 URL（默认由 RS_DB_PATH 派生）
# RS_DATABASE_URL=sqlite+pysqlite:////home/siri/.local/share/rs-service/rs.db

# HTTP 代理（本机 CelesTrak 需要时）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 显式代理（不读 ALL_PROXY，避免 socks:// 报错）
# RS_HTTP_PROXY=http://127.0.0.1:7890

# CelesTrak GP
RS_CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
RS_CELESTRAK_TIMEOUT_SECONDS=60

# 同步：每日 1 次、最多 3 次重试（秒）
RS_SYNC_MAX_RETRIES=3
RS_SYNC_RETRY_DELAYS=300,900,2700

# API / MCP 绑定（只绑 localhost）
RS_API_HOST=127.0.0.1
RS_API_PORT=8766
RS_MCP_HOST=127.0.0.1
RS_MCP_PORT=8765
