[Unit]
Description=RS-Service MCP server (localhost:8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/桌面/RS-Service
EnvironmentFile=-%h/桌面/RS-Service/.env
ExecStart=%h/桌面/RS-Service/.venv/bin/rs-service serve-mcp --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
